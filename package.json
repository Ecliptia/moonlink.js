{
  "name": "moonlink.js",
  "version": "5.3.0-dev.2",
  "description": "NyxLink \u2014 Discord audio client derived from Moonlink.js (development)",
  "keywords": [
    "bot",
    "discord.js",
    "moonlink",
    "discord",
    "easy",
    "lavalink",
    "music"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "pnpm run build && pnpm run test:bot",
    "test": "node --test tests/*.test.cjs",
    "pretest": "pnpm run build",
    "test:bot": "node test-bot/index.js",
    "typecheck": "tsc --noEmit",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module commonjs --moduleResolution node tests/types/public-api.ts",
    "pack:check": "node scripts/check-package.cjs",
    "test:backends": "pnpm run build && node scripts/test-backends.cjs"
  },
  "homepage": "https://github.com/melodiabl/NyxLink#readme",
  "bugs": {
    "url": "https://github.com/melodiabl/NyxLink/issues"
  },
  "license": "Open Software License 3.0",
  "contributors": [
    "1Lucas1.apk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/melodiabl/NyxLink.git"
  },
  "engines": {
    "node": ">=22.x.x"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.3"
  },
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist",
    "assets/nyxlink_banner.png",
    "LICENSE"
  ],
  "dependencies": {
    "consola": "3.4.2"
  }
}
